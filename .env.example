# Rainha das Polpas - Variáveis de Ambiente Frontend

# URL canônica pública do site (utilizada para SEO, OpenGraph e Sitemap)
NEXT_PUBLIC_SITE_URL=https://sites.sysotto.com/rainhadaspolpas

# Caminho público reservado ao site na publicação compartilhada Sysotto
NEXT_PUBLIC_BASE_PATH=/rainhadaspolpas

# Identificador / Slug do site no ecossistema Sysotto
NEXT_PUBLIC_SITE_SLUG=rainhadaspolpas

# URL da API do Sysotto (Módulos de Integração: Sysotto.Inventory, Sysotto.Sales)
# Em ambiente Docker local com proxy same-origin, use /sysotto-api (padrão do Compose)
NEXT_PUBLIC_SYSOTTO_API_URL=/sysotto-api

# Canal Oficial WhatsApp (88) 99709-9082
NEXT_PUBLIC_WHATSAPP_PHONE=5588997099082

# Porta HTTP local exposta pelo Docker Compose (3000-3004 são usadas pela stack Sysotto)
FRONTEND_PORT=3005

# Rede Docker externa da stack Sysotto e upstream interno da API
SYSOTTO_DOCKER_NETWORK=sysotto_sysotto-network
SYSOTTO_API_UPSTREAM=http://sysotto-backend:5036
